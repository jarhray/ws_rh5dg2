  <version>0.1.0</version>
  <description>Bounded synchronous Python client and CLI for the RH5DG2 ROS 2 driver.</description>
  <maintainer email="jarhray@users.noreply.github.com">Jerry</maintainer>
  <license>Proprietary</license>
